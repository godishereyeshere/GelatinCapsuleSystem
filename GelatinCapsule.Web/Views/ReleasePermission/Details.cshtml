@model GelatinCapsule.Domain.Entities.Melting.ReleasePermission
@{
    ViewData["Title"] = $"مجوز ساخت {Model.BatchNo}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3><i class="bi bi-clipboard-check"></i> مجوز ساخت @Model.BatchNo</h3>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-right"></i> بازگشت
    </a>
</div>

<div class="row">
    <div class="col-md-7">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-primary text-white">
                <strong>اطلاعات اصلی</strong>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-5">رکورد تانک</dt>
                    <dd class="col-7"><code>@Model.FeedRecNo</code></dd>

                    <dt class="col-5">شماره بچ</dt>
                    <dd class="col-7">
                        <strong>@Model.BatchNo</strong>
                        @if (Model.CCode == "Y000")
                        {
                            <span class="badge bg-warning text-dark">زرد کهربایی</span>
                        }
                        else if (Model.CCode == "W000")
                        {
                            <span class="badge bg-light text-dark">پیست سفید</span>
                        }
                    </dd>

                    <dt class="col-5">سریال</dt>
                    <dd class="col-7">@Model.Serial</dd>

                    <dt class="col-5">تاریخ</dt>
                    <dd class="col-7">@Model.Farsidate - @Model.Shift</dd>

                    <dt class="col-5">نوع</dt>
                    <dd class="col-7">@Model.Part / @Model.PType / @Model.CCode</dd>

                    <dt class="col-5">شماره دستگاه</dt>
                    <dd class="col-7">@Model.Machine</dd>

                    @if (!string.IsNullOrEmpty(Model.TankNo))
                    {
                        <dt class="col-5">شماره تانک</dt>
                        <dd class="col-7">@Model.TankNo</dd>
                    }

                    <dt class="col-5">حجم اولیه</dt>
                    <dd class="col-7">@Model.Vol0.ToString("N2") L</dd>

                    <dt class="col-5">حجم نهایی</dt>
                    <dd class="col-7">@Model.Vol1.ToString("N2") L</dd>

                    <dt class="col-5">ویسکوزیته اولیه</dt>
                    <dd class="col-7">@Model.Vis0.ToString("N2")</dd>

                    <dt class="col-5">ویسکوزیته نهایی</dt>
                    <dd class="col-7">@Model.Vis1.ToString("N2")</dd>

                    <dt class="col-5">C0 / C1</dt>
                    <dd class="col-7">@Model.C0.ToString("N4") / @Model.C1.ToString("N4")</dd>

                    <dt class="col-5">معادل خشک</dt>
                    <dd class="col-7"><strong>@Model.EqcCapsule.ToString("N4") g</strong></dd>

                    <dt class="col-5">آب مورد نیاز</dt>
                    <dd class="col-7">@Model.WtrNeed.ToString("N2") L</dd>

                    @if (!string.IsNullOrEmpty(Model.Company))
                    {
                        <dt class="col-5">کمپانی</dt>
                        <dd class="col-7">@Model.Company</dd>
                    }

                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <dt class="col-5">توضیحات</dt>
                        <dd class="col-7">@Model.Notes</dd>
                    }

                    <dt class="col-5">تاریخ ثبت</dt>
                    <dd class="col-7">@Model.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-5">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-info text-white">
                <strong>فرمولاسیون مواد</strong>
            </div>
            <div class="card-body p-0">
                <table class="table table-sm table-striped mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>ماده</th>
                            <th>مقدار (g)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Materials.Any())
                        {
                            @foreach (var m in Model.Materials.OrderBy(x => x.SortOrder))
                            {
                                <tr>
                                    <td>@m.MaterialCode</td>
                                    <td><strong>@m.RequiredGr.ToString("N4")</strong></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="2" class="text-center text-muted">
                                    فرمولاسیون ثبت نشده
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-right"></i> بازگشت به لیست
            </a>
        </div>
    </div>
</div>