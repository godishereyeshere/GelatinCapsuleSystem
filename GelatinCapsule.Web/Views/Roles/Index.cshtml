@model List<GelatinCapsule.Domain.Entities.Security.Role>
@{
    ViewData["Title"] = "مدیریت نقش‌ها";
    var userCounts = ViewBag.RoleUserCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-circle"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3><i class="bi bi-shield-lock"></i> مدیریت نقش‌ها</h3>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> نقش جدید
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        @if (Model.Count == 0)
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-shield-slash" style="font-size: 48px;"></i>
                <p class="mt-2">هیچ نقشی تعریف نشده است</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>نام انگلیسی</th>
                            <th>نام نمایشی</th>
                            <th>تعداد کاربران</th>
                            <th>وضعیت</th>
                            <th>نوع</th>
                            <th>عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var i = 1;
                        }
                        @foreach (var role in Model)
                        {
                            var userCount = userCounts.ContainsKey(role.Id) ? userCounts[role.Id] : 0;
                            <tr>
                                <td>@i</td>
                                <td><code>@role.Name</code></td>
                                <td><strong>@role.DisplayName</strong></td>
                                <td><span class="badge bg-info">@userCount کاربر</span></td>
                                <td>
                                    @if (role.IsActive)
                                    {
                                        <span class="badge bg-success">فعال</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">غیرفعال</span>
                                    }
                                </td>
                                <td>
                                    @if (role.IsSystemRole)
                                    {
                                        <span class="badge bg-warning text-dark">سیستمی</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark">عادی</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <a asp-action="Edit" asp-route-id="@role.Id" class="btn btn-sm btn-outline-primary" title="ویرایش">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-controller="Permissions" asp-action="Matrix" asp-route-roleId="@role.Id"
                                           class="btn btn-sm btn-outline-success" title="مدیریت دسترسی‌ها">
                                            <i class="bi bi-key"></i>
                                        </a>
                                        @if (!role.IsSystemRole)
                                        {
                                            <form asp-action="Delete" asp-route-id="@role.Id" method="post" class="d-inline"
                                                  onsubmit="return confirm('از حذف این نقش مطمئن هستید؟');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="حذف">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                            i++;
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>