@model GelatinCapsule.Web.Models.Melting.ProductionTypeViewModel
@{
    ViewData["Title"] = "مورد تولید جدید";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3><i class="bi bi-plus-circle"></i> مورد تولید جدید</h3>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-right"></i> بازگشت
    </a>
</div>

<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="alert alert-danger"></div>

    <div class="row">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white">
                    <strong><i class="bi bi-info-circle"></i> اطلاعات اصلی</strong>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Code" class="form-label"></label>
                            <input asp-for="Code" class="form-control" dir="ltr"
                                   placeholder="مثال: meltDPI" />
                            <span asp-validation-for="Code" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="DisplayName" class="form-label"></label>
                            <input asp-for="DisplayName" class="form-control"
                                   placeholder="مثال: ملت DPI" />
                            <span asp-validation-for="DisplayName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="PType" class="form-label"></label>
                            <input asp-for="PType" class="form-control" dir="ltr"
                                   placeholder="Gelatin / DPI / HPMC / Fish / ..." />
                            <span asp-validation-for="PType" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="CCode" class="form-label"></label>
                            <select asp-for="CCode" class="form-select">
                                @foreach (var c in Model.AvailableCCodes)
                                {
                                    <option value="@c.Value">@c.Label</option>
                                }
                            </select>
                            <span asp-validation-for="CCode" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white">
                    <strong><i class="bi bi-gear"></i> پارامترها</strong>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="PartCode" class="form-label"></label>
                            <input asp-for="PartCode" type="number" class="form-control"
                                   placeholder="3، 4، 1، 2، ..." />
                            <span asp-validation-for="PartCode" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="PermissionCode" class="form-label"></label>
                            <input asp-for="PermissionCode" type="number" class="form-control"
                                   placeholder="8500، 85001، ..." />
                            <span asp-validation-for="PermissionCode" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="DefaultVol0" class="form-label"></label>
                            <input asp-for="DefaultVol0" type="text" class="form-control" dir="ltr" />
                            <span asp-validation-for="DefaultVol0" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white">
                    <strong><i class="bi bi-sort-numeric-up"></i> ترتیب و وضعیت</strong>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="SortOrder" class="form-label"></label>
                        <input asp-for="SortOrder" type="number" class="form-control" />
                    </div>
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label"></label>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white">
                    <strong><i class="bi bi-chat-left-text"></i> توضیحات</strong>
                </div>
                <div class="card-body">
                    <textarea asp-for="Notes" class="form-control" rows="4"></textarea>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-circle"></i> ذخیره
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary">انصراف</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}