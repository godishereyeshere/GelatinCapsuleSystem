@model GelatinCapsule.Domain.Entities.Melting.ProductionType
@{
    ViewData["Title"] = $"جزئیات {Model.DisplayName}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3><i class="bi bi-info-circle"></i> جزئیات مورد تولید</h3>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-right"></i> بازگشت
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">کد</dt>
            <dd class="col-sm-9"><code>@Model.Code</code></dd>

            <dt class="col-sm-3">نام نمایشی</dt>
            <dd class="col-sm-9"><strong>@Model.DisplayName</strong></dd>

            <dt class="col-sm-3">نوع محصول (PType)</dt>
            <dd class="col-sm-9">@Model.PType</dd>

            <dt class="col-sm-3">کد محصول (CCode)</dt>
            <dd class="col-sm-9"><span class="badge bg-secondary">@Model.CCode</span></dd>

            <dt class="col-sm-3">کد قسمت (PartCode)</dt>
            <dd class="col-sm-9">@Model.PartCode</dd>

            <dt class="col-sm-3">کد مجوز</dt>
            <dd class="col-sm-9">@Model.PermissionCode</dd>

            <dt class="col-sm-3">حجم اولیه پیش‌فرض</dt>
            <dd class="col-sm-9">@Model.DefaultVol0.ToString("N2") L</dd>

            <dt class="col-sm-3">ترتیب نمایش</dt>
            <dd class="col-sm-9">@Model.SortOrder</dd>

            <dt class="col-sm-3">وضعیت</dt>
            <dd class="col-sm-9">
                @if (Model.IsActive)
                {
                    <span class="badge bg-success">فعال</span>
                }
                else
                {
                    <span class="badge bg-secondary">غیرفعال</span>
                }
            </dd>

            @if (!string.IsNullOrEmpty(Model.Notes))
            {
                <dt class="col-sm-3">توضیحات</dt>
                <dd class="col-sm-9">@Model.Notes</dd>
            }
        </dl>
    </div>
</div>