@model List<GelatinCapsule.Domain.Entities.Melting.ProductionType>
@{
    ViewData["Title"] = "مدیریت مورد تولید";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3><i class="bi bi-tags"></i> مدیریت مورد تولید</h3>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> مورد تولید جدید
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        @if (Model.Count == 0)
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-inbox" style="font-size: 48px;"></i>
                <p class="mt-2">هیچ موردی ثبت نشده است</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>کد</th>
                            <th>نام نمایشی</th>
                            <th>نوع محصول</th>
                            <th>کد محصول</th>
                            <th>PartCode</th>
                            <th>کد مجوز</th>
                            <th>حجم پیش‌فرض</th>
                            <th>وضعیت</th>
                            <th>عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var i = 1;
                        }
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@i</td>
                                <td><code>@item.Code</code></td>
                                <td><strong>@item.DisplayName</strong></td>
                                <td>@item.PType</td>
                                <td><span class="badge bg-secondary">@item.CCode</span></td>
                                <td>@item.PartCode</td>
                                <td>@item.PermissionCode</td>
                                <td>@item.DefaultVol0.ToString("N2") L</td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">فعال</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">غیرفعال</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <a asp-action="Details" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-info" title="جزئیات">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary" title="ویرایش">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Formulas" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-warning" title="فرمولاسیون">
                                            <i class="bi bi-list-check"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.Id"
                                              method="post" class="d-inline"
                                              onsubmit="return confirm('از حذف این مورد مطمئن هستید؟');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="حذف">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            i++;
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>